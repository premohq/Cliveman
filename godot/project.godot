; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cliveman"
config/description="Detective adventure. Godot port of the 2.0.20 browser build."
config/version="2.0.20"
run/main_scene="res://scenes/Main.tscn"
boot_splash/bg_color=Color(0, 0, 0, 1)
config/features=PackedStringArray("26.2", "GL Compatibility", "Redot")
boot_splash/show_image=false
config/icon="res://assets/images/cliveman-logo.png"

[autoload]

Prefs="*res://scripts/prefs.gd"
I18n="*res://scripts/i18n.gd"
GameState="*res://scripts/game_state.gd"
SoundFx="*res://scripts/audio/sfx.gd"
Stings="*res://scripts/audio/stings.gd"
MusicPlayer="*res://scripts/audio/music.gd"
VoiceCast="*res://scripts/audio/voice.gd"
Pad="*res://scripts/pad.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

